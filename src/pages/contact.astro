---
import Base from "../layouts/Base.astro";
---
<Base title="Contact — Brandon Randle" description="Contact me about data engineering, data-platform software, and backend SWE opportunities for Summer 2027. Baton Rouge, Louisiana.">
  <header class="page-heading contact-heading">
    <div class="contact-copy"><p class="eyebrow"><span class="status-dot"></span>Open to Summer 2027 opportunities</p><h1>Let’s <span class="pink">Connect!</span></h1><p>Data engineering, data-platform software, and backend SWE. Let's talk about what you're building.</p><a class="contact-email" href="mailto:brandon.randle1@lsu.edu">brandon.randle1@lsu.edu <span aria-hidden="true">↗</span></a><div class="contact-links"><a class="text-link" href="https://github.com/cordialApple">GitHub ↗</a><a class="text-link" href="https://www.linkedin.com/in/brandon-randle-link/">LinkedIn ↗</a><a class="text-link" href="/Brandon_Randle_SWE.docx">Résumé (DOCX) ↗</a></div></div>
    <figure class="contact-portrait"><div class="portrait-orbit"><svg viewBox="0 0 360 360" fill="none" aria-hidden="true"><circle cx="180" cy="180" r="166" stroke="var(--edge)"/><ellipse cx="180" cy="180" rx="174" ry="105" transform="rotate(-35 180 180)" stroke="var(--purple)" stroke-width="1"/><path d="M180 4v16m0 320v16M4 180h16m320 0h16" stroke="var(--blue)"/><circle cx="324" cy="91" r="5" fill="var(--pink)"/><circle cx="38" cy="273" r="4" fill="var(--blue)"/></svg><img src="/assets/headshot.png" alt="Brandon Randle" width="926" height="998" /></div><figcaption><strong>Brandon Randle</strong><span>Baton Rouge, Louisiana</span></figcaption></figure>
  </header>
  <div class="contact-details">
    <section aria-labelledby="about-title"><p class="eyebrow">Background</p><h2 id="about-title">From signals to systems.</h2><p>Data Acquisition Lead, LSU Formula SAE.<br />Former Information Systems Intern at RoyOMartin.</p><p>Building reliable paths from raw data to useful decisions.</p><a class="text-link" href="tel:+19853438406">(985) 343-8406 ↗</a></section>
    <section aria-labelledby="education-title"><p class="eyebrow">Education & Certification</p><h2 id="education-title">Louisiana State University</h2><p>Roger Hadfield Honors College</p><dl class="education-list"><div><dt>B.S. Computer Science</dt><dd>Data Science & Analytics · Expected May 2028</dd></div><div><dt>B.S. Mathematics</dt><dd>Computational Mathematics · Expected May 2028</dd></div></dl><p class="metadata">AWS Certified Solutions Architect – Associate · Jul 2026</p></section>
  </div>
</Base>
<style>
  .contact-heading { max-width: none; display: grid; grid-template-columns: minmax(0,1.7fr) minmax(240px,1fr); align-items: center; gap: 60px; padding-block: 80px 72px; }
  .contact-heading h1 { font-size: clamp(2.8rem, 5.2vw, 4.8rem); line-height: 1.04; }
  .contact-copy > p:not(.eyebrow) { max-width: 44ch; color: var(--mid); margin-top: 24px; }
  .contact-email { font-size: clamp(1rem, 2.05vw, 1.6rem); gap: 14px; border-bottom: 1px solid var(--pink); }
  .contact-portrait { width: 100%; max-width: 360px; justify-self: center; }
  .portrait-orbit { position: relative; padding: 40px; }
  .portrait-orbit svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .portrait-orbit img { position: relative; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 50% 30%; border-radius: 50%; border: 1px solid var(--edge); }
  .contact-portrait figcaption { text-align: center; margin-top: 12px; }
  .contact-portrait figcaption strong { font-weight: 500; }
  .contact-portrait figcaption span { display: block; color: var(--mid); font-size: .8rem; margin-top: 4px; }
  .contact-details { gap: 80px; padding-block: 48px 72px; }
  .contact-details h2 { margin-top: 14px; font-size: 1.65rem; }
  .contact-details .eyebrow { margin-top: 0; color: var(--blue); }
  .contact-details .text-link { margin-top: 20px; }
  @media(max-width: 860px) { .contact-heading { gap: 28px; grid-template-columns: minmax(0,1.6fr) minmax(180px,1fr); } .portrait-orbit { padding: 26px; } }
  @media(max-width: 720px) { .contact-heading { grid-template-columns: 1fr; padding-block: 44px; gap: 36px; } .contact-portrait { max-width: 240px; } .contact-details { gap: 36px; padding-block: 36px 48px; } .contact-email { font-size: clamp(.95rem, 4.2vw, 1.45rem); } }
</style>
