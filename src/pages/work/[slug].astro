---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SystemDiagram from "../../components/SystemDiagram.astro";
import EvidenceImage from "../../components/EvidenceImage.astro";
export async function getStaticPaths() {
  return (await getCollection("cases")).map(c => ({ params: { slug: c.id }, props: { c } }));
}
interface Props { c: CollectionEntry<"cases"> }
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
---
<Base title={`${d.title} — Brandon Randle`} description={d.summary}>
  <article class="case-page">
    <a class="text-link back-link" href="/work/">← all work</a>
    <header class="case-heading"><p class:list={["eyebrow", d.accent]}>{d.category}</p><h1>{d.title}</h1><p class="case-summary">{d.summary}</p><p class:list={["case-outcome", d.accent]}>{d.outcome}</p><p class="metadata">{d.stack}</p><div class="source-links">{d.links.map(l => <a class="text-link" href={l.href}>{l.label} ↗</a>)}</div></header>
    <dl class="case-facts"><div><dt>my contribution</dt><dd>{d.role}</dd></div><div><dt>project status</dt><dd>{d.status}</dd></div></dl>
    {d.diagram && <SystemDiagram kind={d.diagram} />}
    {d.image && <EvidenceImage image={d.image} />}
    <div class="case-prose"><Content /></div>
    {d.secondaryImage && <EvidenceImage image={d.secondaryImage} />}
    <div class="case-end"><a class="text-link" href="/work/">← more work</a><a class="text-link" href="mailto:brandon.randle1@lsu.edu">talk through this project ↗</a></div>
  </article>
</Base>
