---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SystemDiagram from "../../components/SystemDiagram.astro";
import EvidenceImage from "../../components/EvidenceImage.astro";
export async function getStaticPaths() {
  return (await getCollection("cases")).map(c => ({ params: { slug: c.id }, props: { c } }));
}
interface Props { c: CollectionEntry<"cases"> }
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
---
<Base title={`${d.title} — Brandon Randle`} description={d.summary}>
  <article class="case-page">
    <a class="text-link back-link" href="/work/">← All work</a>
    <header class="case-heading"><div class="case-label"><p class:list={["eyebrow", d.accent]}>{d.category}</p><span class="eyebrow">Engineering Case Study</span></div><h1>{d.title}</h1><p class="case-summary">{d.summary}</p><div class="case-result"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M6 36V12m0 24h36M12 29l9-9 7 4 12-14" stroke="currentColor" stroke-width="1.5"/><path d="M32 10h8v8" stroke="currentColor" stroke-width="1.5"/></svg><p class:list={["case-outcome", d.accent]}>{d.outcome}</p></div><p class="metadata">{d.stack}</p><div class="source-links">{d.links.map(l => <a class="text-link" href={l.href}>{l.label} ↗</a>)}</div></header>
    <dl class="case-facts"><div><dt>My Contribution</dt><dd>{d.role}</dd></div><div><dt>Project Status</dt><dd>{d.status}</dd></div></dl>
    {d.diagram && <SystemDiagram kind={d.diagram} />}
    {d.image && <EvidenceImage image={d.image} />}
    <div class="case-prose"><Content /></div>
    {d.secondaryImage && <EvidenceImage image={d.secondaryImage} />}
    <div class="case-end"><a class="text-link" href="/work/">← More work</a><a class="text-link" href="mailto:brandon.randle1@lsu.edu">Talk through this project ↗</a></div>
  </article>
</Base>
<style>
  .case-page { padding-block: 36px 64px; }
  .case-heading { max-width: none; }
  .case-label { display: flex; justify-content: space-between; gap: 20px; padding-bottom: 12px; }
  .case-heading h1 { max-width: 18ch; font-size: clamp(2.8rem, 6.1vw, 5.3rem); line-height: 1.04; }
  .case-summary { max-width: 66ch; }
  .case-result { display: flex; align-items: center; gap: 18px; margin-top: 30px; }
  .case-result svg { flex: none; width: 42px; height: 42px; color: var(--purple); }
  .case-result .case-outcome { margin: 0; }
  .source-links { margin-top: 24px; }
  .source-links .text-link { padding-inline: 14px; border: 1px solid var(--edge); text-decoration: none; font-size: .8rem; }
  .source-links .text-link:hover { border-color: var(--pink); }
  .case-facts { background: var(--media); padding: 26px; border: 1px solid var(--edge); }
  .case-facts dt { font-family: var(--font-mono); font-size: .68rem; color: var(--blue); }
  .case-prose { margin-inline: auto; }
  @media(max-width: 720px) { .case-label { flex-direction: column; gap: 8px; } .case-label > span { display: none; } .case-facts { padding: 20px; } .case-result { gap: 12px; } .case-result svg { width: 32px; height: 32px; } .case-page { padding-block: 24px 40px; } }
</style>
