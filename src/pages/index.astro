---
import Base from "../layouts/Base.astro";
import { slide } from "astro:transitions";
---
<Base title="Brandon Randle — data, systems, platforms">
  <section class="view boxed" id="home" transition:animate={slide({ duration: "0.5s" })}>
    <div class="inner">
      <div class="panel home-panel">
        <div class="shapes"><span class="sh s4"></span></div>
        <div class="home-copy">
          <div class="home-mid">
            <h1>I turn noise into <span class="pk">signal.</span></h1>
            <p class="thesis">Building end-to-end from <em>raw data</em> to <em>actionable analysis</em>, profiling down to the metal for better perf, and building on top of platforms: I solve pain points.</p>
          </div>
          <div class="role">Data Acquisition Lead, <b>LSU Formula SAE</b> · CS @ LSU</div>
        </div>
        <div class="home-photo"><img src="/assets/headshot.png" alt="Brandon Randle, LSU Formula SAE" /><span class="frame" aria-hidden="true"></span></div>
      </div>
    </div>
  </section>
</Base>
