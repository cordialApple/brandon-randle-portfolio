---
import Base from "../layouts/Base.astro";
import Experience from "../components/Experience.astro";
import ProjectGlyph from "../components/ProjectGlyph.astro";
const projects = [
  { slug: "production-telemetry", kind: "production", category: "Internship · Data Engineering", title: "Production Telemetry", description: "MQTT ingestion from an IBM Maximo Visual Inspection system into SQL Server, built and taken through deployment at RoyOMartin.", result: "Approved scope → production ingestion", stack: "C# / .NET / MQTTnet / SQL Server", accent: "blue" },
  { slug: "peekbar", kind: "performance", category: "Systems Performance", title: "Peekbar", description: "Browser tabs within reach. A native Windows tool with a profiled, rebuilt activation path.", result: "539 ms → 95 ms median activation", stack: "C++23 / Win32 / ETW", accent: "purple" },
  { slug: "interview", kind: "platform", category: "Backend Software", title: "Interview Platform", description: "Career evidence, retrieval, and coding practice. Connected through explicit storage and API contracts.", result: "19 MCP tools · 2 storage backends", stack: "C# / .NET / SQLite / TypeScript", accent: "pink" },
];
---
<Base>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow hero-intro"><span class="tiny-cross" aria-hidden="true">+</span> Data Engineering / Backend Systems</p>
      <h1 id="intro-title">From noise<br />to <span class="signal-word">signal.</span></h1>
      <p class="hero-description">I’m Brandon. I build the pipelines that make data useful, and the systems that keep it moving.</p>
      <div class="actions"><a class="button" href="#selected-work">Explore my work <span aria-hidden="true">↗</span></a><a class="text-link" href="/contact/">Let’s connect <span aria-hidden="true">↗</span></a></div>
      <p class="hero-location">CS + Mathematics @ LSU <span aria-hidden="true">/</span> Baton Rouge, LA</p>
    </div>
    <figure class="hero-portrait">
      <div class="hero-portrait-frame"><img src="/assets/headshot.png" width="926" height="998" alt="Brandon Randle wearing an LSU Tiger Racing team polo" fetchpriority="high" /></div>
      <figcaption><span>Brandon Randle</span><span class="blue">LSU Formula SAE</span></figcaption>
    </figure>
  </section>
  <div class="context-strip" aria-label="professional focus">
    <span class="context-label">Built in the real world</span>
    <span>RoyOMartin <span class="context-detail">/ Production Systems</span></span>
    <span>LSU Formula SAE <span class="context-detail">/ Race Telemetry</span></span>
    <span>CS + Mathematics <span class="context-detail">/ LSU</span></span>
  </div>
  <section class="section-block selected-work" id="selected-work" aria-labelledby="selected-title">
    <div class="section-heading"><div><p class="eyebrow pink">Selected Projects</p><h2 id="selected-title">Built. Measured. <span class="muted-heading">Explained.</span></h2></div><a class="text-link" href="/work/">All work <span aria-hidden="true">↗</span></a></div>
    <div class="project-grid">
      {projects.map(project => <a class:list={["project-card", `project-${project.accent}`]} href={`/work/${project.slug}/`}>
        <div class="project-art"><ProjectGlyph kind={project.kind} /><span class="project-open" aria-hidden="true">↗</span></div>
        <div class="project-body"><p class:list={["eyebrow", project.accent]}>{project.category}</p><h3>{project.title}</h3><p class="project-description">{project.description}</p><p class="project-result">{project.result}</p><span class="metadata">{project.stack}</span></div>
      </a>)}
    </div>
  </section>
  <Experience />
  <section class="about-strip" aria-labelledby="about-title">
    <img src="/assets/headshot.png" width="926" height="998" alt="Brandon Randle wearing LSU Tiger Racing team polo" loading="lazy" />
    <div><p class="eyebrow blue">Behind the Systems</p><h2 id="about-title">Curiosity, with a debugger.</h2><p>Studying computer science and mathematics at LSU. Building across databases, backend services, and race telemetry. I like following a problem all the way to the source.</p></div>
    <a class="text-link" href="/contact/">More about me <span aria-hidden="true">↗</span></a>
  </section>
</Base>
