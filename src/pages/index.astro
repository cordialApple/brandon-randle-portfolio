---
import Base from "../layouts/Base.astro";
import Experience from "../components/Experience.astro";
---
<Base>
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy">
      <p class="eyebrow">Computer Science B.S. + Mathematics B.S. at LSU</p>
      <h1 id="intro-title">Data Engineering<br /><span class="pink">Backend Systems</span></h1>
      <p class="hero-description">I build pipelines that take data from source to signal as well as the services that keep them running. Currently shipping C#/.NET and SQL Server work at RoyOMartin.</p>
      <div class="actions"><a class="button" href="/work/">Explore My Work <span aria-hidden="true">→</span></a><a class="text-link" href="mailto:brandon.randle1@lsu.edu">Email Me ↗</a></div>
      <p class="availability"><span class="status-dot" aria-hidden="true"></span>Open to Summer 2027 opportunities <span class="location">Baton Rouge, LA</span></p>
    </div>
    <figure class="portrait"><img src="/assets/headshot.png" width="926" height="998" alt="Brandon Randle wearing LSU Tiger Racing team polo" fetchpriority="high" /><figcaption>Brandon Randle <span>LSU Formula SAE</span></figcaption></figure>
  </section>
  <Experience />
  <section class="section-block" aria-labelledby="selected-title">
    <div class="section-heading"><div><h2 id="selected-title">Selected Projects</h2></div><a class="text-link" href="/work/">all work →</a></div>
    <a class="featured-project" href="/work/telemetry/">
      <div class="feature-image"><img src="/assets/telemetry.png" width="1280" height="720" alt="Formula SAE telemetry dashboard with session and sensor summaries" loading="lazy" /></div>
      <div class="feature-copy"><p class="eyebrow blue">data engineering</p><h3>2023 & 2026 Competition Telemetry Pipeline <span aria-hidden="true">↗</span></h3><p>two cars, different log formats, one queryable system. repeatable ingestion, typed APIs, and checks that run against a real database.</p><span class="metadata">Python · TimescaleDB · FastAPI · Power BI</span></div>
    </a>
    <div class="project-pair">
      <a class="compact-project" href="/work/interview/"><p class="eyebrow pink">backend software</p><h3>interview platform <span aria-hidden="true">↗</span></h3><p>19 MCP tools over markdown or SQLite, with source-linked career evidence and coding endpoints.</p><span class="metadata">C#/.NET · SQLite · TypeScript</span></a>
      <a class="compact-project" href="/work/peekbar/"><p class="eyebrow purple">systems performance</p><h3>Peekbar <span aria-hidden="true">↗</span></h3><p>browser tabs within reach. profiled and rebuilt activation path: median latency from 539 ms to 95 ms.</p><span class="metadata">C++23 · Win32 · ETW</span></a>
    </div>
  </section>
</Base>
