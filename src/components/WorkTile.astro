---
import type { CollectionEntry } from "astro:content";
interface Props { entry: CollectionEntry<"cases"> }
const { entry } = Astro.props;
const c = entry.data;
---
<a class="work-row" href={`/work/${entry.id}/`}>
  <div class="work-category"><span class:list={["eyebrow", c.accent]}>{c.category}</span><span class="metadata">{c.status}</span></div>
  <div><h2>{c.title}</h2><p>{c.summary}</p><span class="work-outcome">{c.outcome}</span><span class="metadata">{c.stack}</span></div>
  <span class="work-arrow" aria-hidden="true">↗</span>
</a>
