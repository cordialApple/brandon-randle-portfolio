---
interface Props { section: "home" | "work" | "contact" }
const { section } = Astro.props;
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Brandon Randle, home"><span class="tick" aria-hidden="true"></span>Brandon Randle</a>
  <nav aria-label="main navigation">
    <a href="/work/" aria-current={section === "work" ? "page" : undefined}>Work</a>
    <a href="/contact/" aria-current={section === "contact" ? "page" : undefined}>Contact</a>
    <a class="resume-link" href="/resume.pdf">Resume <span aria-hidden="true">↗</span><span class="sr-only"> (PDF)</span></a>
  </nav>
</header>
