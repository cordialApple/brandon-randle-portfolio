    <path d="M140 15V124" stroke="currentColor" opacity=".2" stroke-dasharray="3 5" />
  </>}
  {kind === "platform" && <>
    <path d="M82 47H125L151 76M82 114H122L151 84M209 80H244L270 47M244 80L270 114" stroke="currentColor" opacity=".6" />
    <path d="M151 61L180 45L209 61V98L180 114L151 98Z" fill="currentColor" fill-opacity=".07" stroke="currentColor" /><path d="M151 61L180 78L209 61M180 78V114" stroke="currentColor" />
    <rect x="48" y="32" width="34" height="29" rx="3" stroke="currentColor" /><path d="M56 42L61 47L56 52M65 52H73" stroke="currentColor" />
    <rect x="48" y="100" width="34" height="29" rx="3" stroke="currentColor" /><path d="M57 110H73M57 117H68" stroke="currentColor" />
    <ellipse cx="288" cy="34" rx="18" ry="7" stroke="currentColor" /><path d="M270 34V56C270 66 306 66 306 56V34M270 45C270 55 306 55 306 45" stroke="currentColor" />
    <rect x="271" y="99" width="34" height="29" rx="3" stroke="currentColor" /><path d="M279 109H297M279 116H291" stroke="currentColor" />
    <circle cx="124" cy="47" r="3" fill="currentColor" /><circle cx="244" cy="80" r="3" fill="currentColor" />
  </>}
  {kind !== "telemetry" && kind !== "platform" && kind !== "production" && <>
    <path d="M68 124A112 112 0 0 1 292 124" stroke="currentColor" stroke-width="1" opacity=".25" />
    <path d="M85 124A95 95 0 0 1 275 124" stroke="currentColor" stroke-width="9" opacity=".1" />
    <path d="M85 124A95 95 0 0 1 252 62" stroke="currentColor" stroke-width="3" />
    <path d="M180 23V34M109 53L117 61M251 53L243 61M78 124H89M271 124H282" stroke="currentColor" />
    <path d="M180 124L242 73" stroke="currentColor" stroke-width="2" /><circle cx="180" cy="124" r="6" fill="currentColor" /><circle cx="180" cy="124" r="13" stroke="currentColor" opacity=".3" />
    <path d="M23 145H337" stroke="currentColor" opacity=".15" />
  </>}
</svg>
