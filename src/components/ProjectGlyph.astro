    <rect x="26" y="52" width="68" height="56" rx="4" stroke="currentColor" /><path d="M39 67H80M39 79H67M39 91H75M94 80H140M220 80H266" stroke="currentColor" />
    <path d="M140 56L180 34L220 56V104L180 126L140 104ZM140 56L180 80L220 56M180 80V126" stroke="currentColor" fill="currentColor" fill-opacity=".07" />
    <ellipse cx="300" cy="56" rx="34" ry="12" stroke="currentColor" /><path d="M266 56V104C266 120 334 120 334 104V56M266 80C266 96 334 96 334 80" stroke="currentColor" />
  </>}
  {kind === "telemetry" && <>
    <path d="M20 107H66L78 94L90 115L108 70L122 96L140 36L154 112L174 69L192 87H214L227 56L242 93L257 75L278 82H340" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    <path d="M20 124H340M20 26V133" stroke="currentColor" opacity=".3" />
    <path d="M20 96C62 94 64 49 99 59S137 126 174 102S217 35 254 51S308 108 340 57" stroke="currentColor" opacity=".28" stroke-dasharray="4 5" />
