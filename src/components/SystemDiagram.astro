---
interface Props { kind: "production" | "platform" }
const { kind } = Astro.props;
const steps = [
  { label: "IBM Maximo Visual Inspection", glyph: "M8 12h32v24H8zM18 18h12v12H18zM15 7v5m18-5v5M15 36v5m18-5v5" },
  { label: "MQTT over TLS", glyph: "M12 20a12 12 0 0 1 24 0M7 15a20 20 0 0 1 34 0M17 25a7 7 0 0 1 14 0M24 29v12m-4-4 4 4 4-4" },
  { label: "C#/.NET worker", glyph: "m17 14-10 10 10 10m14-20 10 10-10 10M27 10l-6 28" },
  { label: "SQL Server", glyph: "M9 12c0-7 30-7 30 0s-30 7-30 0Zm0 0v24c0 7 30 7 30 0V12M9 24c0 7 30 7 30 0" },
];
---
<figure class="system-figure">
  <div class="diagram-heading"><span class="eyebrow">{kind === "production" ? "Production Data Flow" : "System Architecture"}</span><span class="diagram-mark" aria-hidden="true">● ─── ●</span></div>
  {kind === "production" ? (
    <><ol class="pipeline-flow" aria-label="production telemetry data flow">{steps.map((step) => <li><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d={step.glyph} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>{step.label}</span></li>)}</ol><figcaption>Direct ingestion from internal edge broker; no intermediate third-party broker.</figcaption></>
  ) : (
    <><div class="platform-flow"><div><strong>Recall-Seed</strong><span>C#/.NET MCP server</span></div><span class="flow-direction" aria-hidden="true">↔</span><div><strong>Markdown vault or SQLite</strong><span>One storage interface, two implementations</span></div></div><div class="platform-clients"><p><strong>STARfolio</strong><span>Desktop interviews + SQLite search</span></p><p><strong>Scroll</strong><span>Coding endpoints + grading callbacks</span></p></div><figcaption>Recall-Seed can use STARfolio’s SQLite store and exchange coding challenges with Scroll. Each system has a distinct responsibility.</figcaption></>
  )}
</figure>
<style>
  .system-figure { padding: 32px; border-radius: 0; background: linear-gradient(145deg, #171029, var(--media)); }
  .diagram-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
  .diagram-heading .eyebrow { color: var(--blue); font-size: .65rem; }
  .diagram-mark { color: var(--purple); font-size: .7rem; letter-spacing: .12em; }
  .pipeline-flow li { display: flex; flex-direction: column; gap: 14px; padding-block: 20px 8px; }
  .pipeline-flow svg { width: 44px; height: 44px; color: var(--blue); }
  .pipeline-flow li + li::before { top: 68px; color: var(--pink); }
  .system-figure figcaption { margin-top: 24px; font-size: .8rem; }
  .platform-clients p { border-left: 2px solid var(--purple); padding-left: 18px; }
  @media(max-width: 720px) { .system-figure { padding: 22px; } .pipeline-flow li { flex-direction: row; align-items: center; gap: 16px; padding-block: 14px; } .pipeline-flow svg { width: 32px; height: 32px; flex: none; } .diagram-heading { margin-bottom: 20px; } }
</style>
